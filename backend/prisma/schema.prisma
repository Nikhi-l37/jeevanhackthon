datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Employee {
  id                        String   @id
  name                      String
  role                      String
  skills                    String[]
  tenureMonths              Int
  performanceScore          Float
  promotionsCount           Int
  lastRoleChangeMonths      Int
  salaryBand                String   // 'low' | 'medium' | 'high'
  
  // Scenario 3: Early Risk & Retention fields
  recentWorkloadLevel       String   // 'low' | 'medium' | 'high'
  overtimeHoursLast4Weeks   Int
  engagementScore           Float
  managerCheckinsLastMonth  Int
  ptoDaysTakenLast90Days    Int
  projectCriticality        String   // 'low' | 'medium' | 'high'
  projectEndInDays          Int
  recognitionLast60Days     String   // 'low' | 'medium' | 'high'
  internalMobilityInterest  String   // 'low' | 'medium' | 'high'
  
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}

model Candidate {
  id              String   @id
  name            String
  role            String
  skills          String[]
  experienceYears Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Job {
  id             String   @id
  title          String
  department     String
  requiredSkills String[]
  level          String   // 'junior' | 'mid' | 'senior'
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Program {
  id             String   @id
  name           String
  department     String
  requiredSkills String[]
  urgency        String   // 'low' | 'medium' | 'high'
  businessImpact String   // 'low' | 'medium' | 'high'
  headcountNeeded Int
  deadlineInWeeks Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ScenarioLog {
  id           String   @id @default(uuid())
  scenarioType String   // 'capability-gap' | 'expectation-balance' | 'early-risk' | 'allocation'
  inputData    String   // JSON stringified input
  resultData   String   // JSON stringified output
  createdAt    DateTime @default(now())
}
